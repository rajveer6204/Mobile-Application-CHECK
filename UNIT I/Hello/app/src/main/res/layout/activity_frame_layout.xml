<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <include layout="@layout/layout_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FrameLayout Overlapping Views Demo"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="32dp"
            android:background="#E2E8F0"
            android:padding="8dp">

            <!-- Layer 1: Background Base Card -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/primary_indigo" />

            <!-- Layer 2: Center Image -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_frame"
                app:tint="@color/white"
                android:contentDescription="Layer Image" />

            <!-- Layer 3: Top-Right Notification Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="#EF4444"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Badge 99+"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Layer 4: Bottom Text Banner Overlay -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#CC0F172A"
                android:gravity="center"
                android:padding="10dp"
                android:text="Overlapping View Overlay"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </FrameLayout>

    </LinearLayout>
</LinearLayout>
